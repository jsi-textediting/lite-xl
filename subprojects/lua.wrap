# TODO: CMake bundles Lua 5.5.1 (lite_xl_plugin_api.h is generated from it), but
# WrapDB only publishes lua 5.5.0-1 (no 5.5.1 build-file patch exists yet, and
# packagefiles/lua/lua-5.5.1-unicode.diff patches the Makefile, not the WrapDB
# meson.build). Meson builds therefore still use Lua 5.5.0 until WrapDB adds 5.5.1.
# Source tarball sha256 for 5.5.1 (verified): 1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce
[wrap-file]
directory = lua-5.5.0
source_url = https://www.lua.org/ftp/lua-5.5.0.tar.gz
source_filename = lua-5.5.0.tar.gz
source_hash = 57ccc32bbbd005cab75bcc52444052535af691789dba2b9016d5c50640d68b3d
patch_filename = lua_5.5.0-1_patch.zip
patch_url = https://wrapdb.mesonbuild.com/v2/lua_5.5.0-1/get_patch
patch_hash = 69ec4a2dd99ecf8e84830093d418f3a5be1202f16ba8d636b3008b67506e5cca
source_fallback_url = https://github.com/mesonbuild/wrapdb/releases/download/lua_5.5.0-1/lua-5.5.0.tar.gz
wrapdb_version = 5.5.0-1
diff_files = lua/lua-5.5.0-unicode.diff

[provide]
lua-5.5 = lua_dep
lua = lua_dep
