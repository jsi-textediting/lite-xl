# Set the default behavior, in case people don't have core.autocrlf set.
# See https://help.github.com/en/articles/dealing-with-line-endings
* text=auto

winlib/*  linguist-vendored
src/lib/* linguist-vendored
resources/icons/icon.inl linguist-vendored

# patches must keep LF so they apply to the upstream (LF) tarballs on Windows
subprojects/packagefiles/**/*.diff -text

# shell scripts must keep LF (they run under WSL/Linux from a Windows checkout)
*.sh text eol=lf
